{
  "manifest_version": 3,
  "name": "URL Reputation Guard",
  "version": "1.1.0",
  "description": "Checks every site you visit against VirusTotal, Google Safe Browsing, URLhaus, and AlienVault OTX, and warns you before you land on a phishing or malicious page.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.virustotal.com/*",
    "https://safebrowsing.googleapis.com/*",
    "https://urlhaus-api.abuse.ch/*",
    "https://otx.alienvault.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "URL Reputation Guard"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "102"
}
